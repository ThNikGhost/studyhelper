# ===========================================
# StudyHelper - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# NEVER commit .env to git!

# -------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------
POSTGRES_USER=studyhelper
POSTGRES_PASSWORD=changeme
POSTGRES_DB=studyhelper
DATABASE_URL=postgresql+asyncpg://studyhelper:changeme@localhost:5432/studyhelper

# -------------------------------------------
# Redis
# -------------------------------------------
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@localhost:6379/0

# -------------------------------------------
# JWT Authentication
# -------------------------------------------
# Generate with: openssl rand -hex 32
# Must be at least 32 characters in production
SECRET_KEY=change-me-in-production-min-32-chars

# -------------------------------------------
# Application
# -------------------------------------------
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -------------------------------------------
# Schedule Parser
# -------------------------------------------
SCHEDULE_URL=https://eservice.omsu.ru/schedule/#/schedule/group/5028
SCHEDULE_UPDATE_INTERVAL_HOURS=6

# -------------------------------------------
# File Storage
# -------------------------------------------
# UPLOAD_DIR=./uploads
# MAX_FILE_SIZE_MB=50

# -------------------------------------------
# Optional: Sentry error tracking
# -------------------------------------------
# SENTRY_DSN=
# VITE_SENTRY_DSN=

# -------------------------------------------
# Optional: Telegram bot
# -------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_URL=
# TELEGRAM_WEBHOOK_SECRET=

# -------------------------------------------
# Optional: Backup encryption (gpg AES-256)
# -------------------------------------------
# BACKUP_ENCRYPTION_KEY=
